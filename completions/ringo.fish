function __ringo_should_offer_completions_for_flags_or_options -a expected_commands
    set -l non_repeating_flags_or_options $argv[2..]
    set -l non_repeating_flags_or_options_absent 0
    set -l positional_index 0
    set -l commands
    __ringo_parse_tokens
    test "$commands" = "$expected_commands"; and return $non_repeating_flags_or_options_absent
end

function __ringo_should_offer_completions_for_positional -a expected_commands positional_index_comparison expected_positional_index
    set -l non_repeating_flags_or_options
    set -l non_repeating_flags_or_options_absent 0
    set -l positional_index 0
    set -l commands
    __ringo_parse_tokens
    test "$commands" = "$expected_commands" -a \( "$positional_index" "$positional_index_comparison" "$expected_positional_index" \)
end

function __ringo_parse_tokens -S
    set -l unparsed_tokens (__ringo_tokens -pc)
    switch $unparsed_tokens[1]
    case 'ringo'
        __ringo_parse_subcommand 0 'version' 'h/help'
        switch $unparsed_tokens[1]
        case 'convert'
            __ringo_parse_subcommand -r 1 't/to=' 'quality=' 'preset=' 'dpi=' 'pages=' 'sheet=' 'page-size=' 'keep-timestamps' 'fps=' 'max-width=' 'max-duration=' 'audio-bitrate=' 'provider=' 'timeout=' 'strip-metadata' 'ocr' 'no-ocr' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'plan'
            __ringo_parse_subcommand -r 1 't/to=' 'quality=' 'preset=' 'dpi=' 'pages=' 'sheet=' 'page-size=' 'keep-timestamps' 'fps=' 'max-width=' 'max-duration=' 'audio-bitrate=' 'provider=' 'timeout=' 'strip-metadata' 'ocr' 'no-ocr' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'formats'
            __ringo_parse_subcommand 0 'category=' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'capabilities'
            __ringo_parse_subcommand 0 'from=' 'to=' 'all' 'available' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'inspect'
            __ringo_parse_subcommand 1 'json' 'events' 'no-network' 'version' 'h/help'
        case 'tools'
            __ringo_parse_subcommand 0 'json' 'events' 'no-network' 'version' 'h/help'
        case 'compress'
            __ringo_parse_subcommand -r 1 'preset=' 'target-size=' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'in-place' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'metadata'
            __ringo_parse_subcommand 0 'version' 'h/help'
            switch $unparsed_tokens[1]
            case 'show'
                __ringo_parse_subcommand 1 'json' 'events' 'no-network' 'version' 'h/help'
            case 'strip'
                __ringo_parse_subcommand -r 1 'location-only' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'in-place' 'json' 'events' 'no-network' 'version' 'h/help'
            case 'set'
                __ringo_parse_subcommand -r 1 'field=+' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'in-place' 'json' 'events' 'no-network' 'version' 'h/help'
            end
        case 'edit'
            __ringo_parse_subcommand 0 'version' 'h/help'
            switch $unparsed_tokens[1]
            case 'rotate'
                __ringo_parse_subcommand -r 1 'degrees=' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'in-place' 'json' 'events' 'no-network' 'version' 'h/help'
            case 'flip'
                __ringo_parse_subcommand -r 1 'vertical' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'in-place' 'json' 'events' 'no-network' 'version' 'h/help'
            case 'resize'
                __ringo_parse_subcommand -r 1 'percent=' 'max=' 'width=' 'height=' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'in-place' 'json' 'events' 'no-network' 'version' 'h/help'
            case 'trim'
                __ringo_parse_subcommand -r 1 'start=' 'end=' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'json' 'events' 'no-network' 'version' 'h/help'
            case 'extract-audio'
                __ringo_parse_subcommand -r 1 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'json' 'events' 'no-network' 'version' 'h/help'
            case 'mute'
                __ringo_parse_subcommand -r 1 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'json' 'events' 'no-network' 'version' 'h/help'
            case 'pdf'
                __ringo_parse_subcommand -r 1 'rotate=' 'pages=' 'delete=' 'extract=' 'order=' 'reverse' 'split' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'json' 'events' 'no-network' 'version' 'h/help'
            case 'merge'
                __ringo_parse_subcommand -r 1 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'json' 'events' 'no-network' 'version' 'h/help'
            end
        case 'crop'
            __ringo_parse_subcommand -r 1 'rect=' 'aspect=' 'normalized' 'pages=' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'in-place' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'annotate'
            __ringo_parse_subcommand -r 1 'spec=' 'flatten' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'redact'
            __ringo_parse_subcommand -r 1 'regions=' 'text=+' 'pattern=+' 'case-sensitive' 'dpi=' 'no-ocr' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'archive'
            __ringo_parse_subcommand -r 1 'format=' 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'extract'
            __ringo_parse_subcommand -r 1 'o/output=' 'output-dir=' 'overwrite' 'dry-run' 'jobs=' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'watch'
            __ringo_parse_subcommand 1 't/to=' 'move-originals' 'once' 'quality=' 'preset=' 'dpi=' 'pages=' 'sheet=' 'page-size=' 'keep-timestamps' 'fps=' 'max-width=' 'max-duration=' 'audio-bitrate=' 'provider=' 'timeout=' 'strip-metadata' 'ocr' 'no-ocr' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'batch'
            __ringo_parse_subcommand 0 'manifest=' 'json' 'events' 'no-network' 'version' 'h/help'
        case 'providers'
            __ringo_parse_subcommand 1 'json' 'events' 'no-network' 'version' 'h/help'
        case 'settings'
            __ringo_parse_subcommand 3 'json' 'events' 'no-network' 'version' 'h/help'
        case 'version'
            __ringo_parse_subcommand 0 'json' 'events' 'no-network' 'version' 'h/help'
        case 'help'
            __ringo_parse_subcommand -r 1 'version'
        end
    end
end

function __ringo_tokens
    if test (string split -m 1 -f 1 -- . "$FISH_VERSION") -gt 3
        commandline --tokens-raw $argv
    else
        commandline -o $argv
    end
end

function __ringo_parse_subcommand -S -a positional_count
    argparse -s r -- $argv
    set -l option_specs $argv[2..]
    set -l is_repeating_positional $_flag_r
    set -el _flag_r
    set -a commands $unparsed_tokens[1]
    set positional_index 0
    while true
        set -e unparsed_tokens[1]
        argparse -sn "$commands" $option_specs -- $unparsed_tokens 2> /dev/null
        set unparsed_tokens $argv
        set positional_index (math $positional_index + 1)
        for non_repeating_flag_or_option in $non_repeating_flags_or_options
            if set -ql "_flag_$(string replace -a - _ -- $non_repeating_flag_or_option)"
                set non_repeating_flags_or_options_absent 1
                break
            end
        end
        test (count $unparsed_tokens) -eq 0 -o \( -z "$is_repeating_positional" -a "$positional_index" -gt "$positional_count" \) && break
    end
end

function __ringo_complete_directories
    set -l token (commandline -t)
    string match -- '*/' $token
    set -l subdirs $token*/
    printf %s\n $subdirs
end

function __ringo_custom_completion
    set -x SAP_SHELL fish
    set -x SAP_SHELL_VERSION $FISH_VERSION
    set -l tokens (__ringo_tokens -p)
    if test -z "$(__ringo_tokens -t)"
        set -l index (count (__ringo_tokens -pc))
        set tokens $tokens[..$index] \'\' $tokens[(math $index + 1)..]
    end
    command $tokens[1] $argv $tokens
end

